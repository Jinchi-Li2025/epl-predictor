{
  "version": "1.0",
  "enabled": true,
  "base_url": "https://api.deepseek.com",
  "default_model": "deepseek-flash",
  "news_lookback_days": 7,
  "max_articles_per_team": 8,
  "cache_ttl_hours": 12,
